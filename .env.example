# Public API listener
HOST=0.0.0.0
PORT=8080
DEBUG=false

# Authorized upstream JSON provider
# Leave empty until you have a provider you are authorized to use.
PROVIDER_BASE_URL=

# Optional server-side credential for an upstream that explicitly requires it.
PROVIDER_BEARER_TOKEN=

# Optional JSON object for non-bearer upstream headers.
# Example: {"X-Custom-Header":"value"}
PROVIDER_HEADERS_JSON=

PROVIDER_TIMEOUT=20
